+/* Balance each successful power-up before retrying a read-only INIT request. */
+static int cam_eeprom_read_calibration_retry(struct cam_eeprom_ctrl_t *e_ctrl,
+	struct cam_packet *packet)
+{
+	struct cam_eeprom_soc_private *soc_private = e_ctrl->soc_info.soc_private;
+	int rc = -EINVAL, down_rc, attempt;
+	bool read_complete;
+
+	for (attempt = 0; attempt < MAX_RETRY_TIMES; attempt++) {
+		rc = cam_eeprom_power_up(e_ctrl, &soc_private->power_info);
+		if (rc) {
+			CAM_ERR(CAM_EEPROM, "power up failed rc %d at times %d",
+				rc, attempt);
+			usleep_range(10000, 11000);
+			continue;
+		}
+
+		e_ctrl->cam_eeprom_state = CAM_EEPROM_CONFIG;
+		rc = cam_eeprom_read_memory(e_ctrl, &e_ctrl->cal_data);
+		read_complete = !rc;
+		if (read_complete)
+			rc = cam_eeprom_get_cal_data(e_ctrl, packet);
+		else
+			CAM_ERR(CAM_EEPROM, "read failed rc %d at times %d",
+				rc, attempt);
+
+		/* Do not request another set of GPIO/pinctrl/clock resources while
+		 * the preceding successful power-up is still active.
+		 */
+		down_rc = cam_eeprom_power_down(e_ctrl);
+		if (down_rc) {
+			CAM_ERR(CAM_EEPROM, "retry cleanup failed rc %d", down_rc);
+			return rc ? rc : down_rc;
+		}
+		e_ctrl->cam_eeprom_state = CAM_EEPROM_ACQUIRE;
+		if (read_complete)
+			return rc;
+		usleep_range(10000, 11000);
+	}
+	return rc;
