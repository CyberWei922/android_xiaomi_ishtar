diff --git a/backuptool_broker/backuptool_staged.sh b/backuptool_broker/backuptool_staged.sh
new file mode 100644
index 0000000..1266536
--- /dev/null
+++ b/backuptool_broker/backuptool_staged.sh
@@ -0,0 +1,70 @@
+#!/system/bin/sh
+# Copyright (C) 2026 CyberWei
+# SPDX-License-Identifier: Apache-2.0
+# Protocol 2: only tmpfs staging; the native broker owns all mounts and commits.
+[ "$BACKUPTOOL_BROKER_PROTOCOL" = 2 ] || exit 2
+export S=/system C=/postinstall/tmp/backupdir V=17.0 ADDOND_VERSION=3
+export all_V3_partitions="vendor product system_ext" backuptool_ab=true
+result=0
+checked() {
+  "$@"
+  local rc="$?"
+  if [ "$rc" -ne 0 ]; then
+    [ "$result" -ne 0 ] || result="$rc"
+    echo "backuptool staged: $* failed ($rc)" >&2
+  fi
+  return "$rc"
+}
+version() {
+  local value
+  value=$(grep '^# ADDOND_VERSION=' "$1" | cut -d= -f2)
+  [ -n "$value" ] || value=1
+  case "$value" in 1|2|3) echo "$value" ;; *) return 1 ;; esac
+}
+# No direct target write, mount, blockdev, relabel, or security-context copy.
+checked mkdir -p "$C" /postinstall/tmp/backupmeta /postinstall/tmp/restore /postinstall/tmp/restoremeta || exit "$result"
+checked cp -p /system/bin/backuptool_ab.functions /postinstall/tmp/backuptool.functions || exit "$result"
+if ! grep -q '^ro.evolution.version=17\.0' /product/etc/build.prop /system/build.prop; then
+  echo 'backuptool staged: incompatible source ROM' >&2
+  exit 2
+fi
+if [ ! -d /system/addon.d ]; then exit 0; fi
+checked mkdir -p /postinstall/tmp/addon.d || exit "$result"
+# Only preserve mode/ownership/timestamps and non-security xattrs for scripts.
+# Data file security metadata is encoded by backuptool_store and committed offline.
+checked cp -RP --preserve=motx /system/addon.d/. /postinstall/tmp/addon.d/ || exit "$result"
+checked find /postinstall/tmp/addon.d -name '*.sh' > /postinstall/tmp/addon-list || exit "$result"
+checked sort -n /postinstall/tmp/addon-list -o /postinstall/tmp/addon-list || exit "$result"
+while IFS= read -r script; do
+  if [ -L "$script" ] || [ ! -f "$script" ]; then
+    echo "backuptool staged: addon entry is not a regular script: $script" >&2
+    exit 2
+  fi
+  n=$(version "$script") || exit 2
+  if [ "$n" = 1 ]; then checked rm "$script" || exit "$result"; continue; fi
+  checked chmod 755 "$script" || exit "$result"
+  checked sed -i '0,/#!\/sbin\/sh/{s|#!/sbin/sh|#!/system/bin/sh|}' "$script" || exit "$result"
+  checked sed -i 's|. /tmp/backuptool.functions|. /postinstall/tmp/backuptool.functions|g' "$script" || exit "$result"
+done < /postinstall/tmp/addon-list
+run_stages() {
+  local script n stage
+  while IFS= read -r script; do
+    [ -f "$script" ] || continue
+    n=$(version "$script") || { [ "$result" -ne 0 ] || result=2; continue; }
+    for stage in "$@"; do
+      if [ "$n" = 2 ]; then ADDOND_VERSION=2 checked /system/bin/sh "$script" "$stage"
+      else ADDOND_VERSION=3 checked /system/bin/sh "$script" "$stage"; fi
+    done
+  done < /postinstall/tmp/addon-list
+}
+run_stages pre-backup backup post-backup
+# A failed backup must not publish a partial restore or start an offline commit.
+[ "$result" -eq 0 ] || exit "$result"
+[ ! -s /postinstall/tmp/store-failures ] || exit 2
+run_stages pre-restore restore post-restore
+[ "$result" -eq 0 ] || exit "$result"
+[ ! -s /postinstall/tmp/store-failures ] || exit 2
+checked mkdir -p /postinstall/tmp/restore/system/addon.d || exit "$result"
+checked cp -RP --preserve=motx /postinstall/tmp/addon.d/. /postinstall/tmp/restore/system/addon.d/ || exit "$result"
+checked sync
+exit "$result"
diff --git a/backuptool_broker/broker.cpp b/backuptool_broker/broker.cpp
new file mode 100644
index 0000000..a5a8cc7
--- /dev/null
+++ b/backuptool_broker/broker.cpp
@@ -0,0 +1,47 @@
+// Copyright (C) 2026 CyberWei
+// SPDX-License-Identifier: Apache-2.0
+#include "broker.h"
+#include <array>
+namespace backuptool_broker {
+int Run(Operations& op) {
+  if (!op.Validate()) return 20;
+  if (!op.IsolateMounts()) return 21;
+  if (!op.MountWorkspace()) return 22;
+  constexpr std::array<const char*, 10> views = {
+      "/postinstall/odm", "/postinstall/inactive-odm",
+      "/postinstall/system_ext", "/postinstall/inactive-system_ext",
+      "/postinstall/product", "/postinstall/inactive-product",
+      "/postinstall/vendor", "/postinstall/inactive-vendor",
+      "/postinstall/system", "/postinstall/inactive-root"};
+  int result = 0;
+  const auto unmount_views = [&]() {
+    bool success = true;
+    for (const char* path : views) if (!op.UnmountIfMounted(path)) success = false;
+    return success;
+  };
+  const auto finish = [&]() {
+    if (!unmount_views() && !result) result = 70;
+    if (!op.UnmountIfMounted("/postinstall") && !result) result = 70;
+    return result;
+  };
+  for (const char* path : {"/postinstall/.broker", "/postinstall/.broker/contexts",
+       "/postinstall/inactive-root", "/postinstall/system", "/postinstall/tmp",
+       "/postinstall/vendor", "/postinstall/inactive-vendor",
+       "/postinstall/product", "/postinstall/inactive-product",
+       "/postinstall/system_ext", "/postinstall/inactive-system_ext",
+       "/postinstall/odm", "/postinstall/inactive-odm"}) {
+    if (!op.MakeDirectory(path)) { result = 23; return finish(); }
+  }
+  if (!op.MountTarget("/postinstall/inactive-root")) { result = 24; return finish(); }
+  if (!op.BindSystem("/postinstall/inactive-root", "/postinstall/system")) { result = 25; return finish(); }
+  if (!op.MountExtras()) { result = 30; return finish(); }
+  if (!op.SnapshotContexts()) { result = 31; return finish(); }
+  result = op.RunWorker();
+  if (result) return finish();
+  // Offline ext4 writes cannot coexist with a kernel mount of the target,
+  // even a read-only one. Never commit after any failed unmount.
+  if (!unmount_views()) { result = 32; return finish(); }
+  result = op.Commit();
+  return finish();
+}
+}
diff --git a/backuptool_broker/broker.h b/backuptool_broker/broker.h
new file mode 100644
index 0000000..dafee9e
--- /dev/null
+++ b/backuptool_broker/broker.h
@@ -0,0 +1,24 @@
+// Copyright (C) 2026 CyberWei
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <string>
+namespace backuptool_broker {
+// All filesystem writes are staged; only the native offline committer receives
+// block-device access. Namespace isolation alone is not a complete sandbox.
+class Operations {
+ public:
+  virtual ~Operations() = default;
+  virtual bool Validate() = 0;
+  virtual bool IsolateMounts() = 0;
+  virtual bool MountWorkspace() = 0;
+  virtual bool MakeDirectory(const std::string& path) = 0;
+  virtual bool MountTarget(const std::string& path) = 0;
+  virtual bool BindSystem(const std::string& root, const std::string& view) = 0;
+  virtual bool MountExtras() = 0;
+  virtual bool SnapshotContexts() = 0;
+  virtual int RunWorker() = 0;
+  virtual bool UnmountIfMounted(const std::string& path) = 0;
+  virtual int Commit() = 0;
+};
+int Run(Operations& operations);
+}
diff --git a/backuptool_broker/main.cpp b/backuptool_broker/main.cpp
new file mode 100644
index 0000000..7bb50ef
--- /dev/null
+++ b/backuptool_broker/main.cpp
@@ -0,0 +1,223 @@
+// Copyright (C) 2026 CyberWei
+// SPDX-License-Identifier: Apache-2.0
+#include "broker.h"
+#include "worker.h"
+#include <fcntl.h>
+#include <linux/fs.h>
+#include <sched.h>
+#include <selinux/selinux.h>
+#include <sys/ioctl.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <signal.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+namespace {
+constexpr char kRoot[] = "/postinstall";
+constexpr char kRootContext[] = "u:object_r:backuptool_broker_root_file:s0";
+constexpr char kWorkContext[] = "u:object_r:backuptool_workspace_file:s0";
+constexpr char kTargetOptions[] = "context=u:object_r:postinstall_file:s0";
+struct Fd { int n; explicit Fd(int value) : n(value) {} ~Fd() { if (n >= 0) close(n); } };
+struct Part { std::string name, target, source, filesystem; dev_t target_id = 0, source_id = 0; };
+bool Error(const std::string& what) {
+  std::cerr << "backuptool_broker: " << what << ": " << std::strerror(errno) << '\n'; return false;
+}
+bool Directory(const std::string& path) {
+  struct stat info {}; return lstat(path.c_str(), &info) == 0 && S_ISDIR(info.st_mode);
+}
+bool Mounted(const std::string& path, bool* found, dev_t device = 0) {
+  std::ifstream input("/proc/self/mountinfo"); if (!input.is_open()) return Error("open mountinfo");
+  *found = false; std::string line;
+  while (std::getline(input, line)) {
+    std::istringstream fields(line); std::string id, parent, number, root, mountpoint;
+    if (!(fields >> id >> parent >> number >> root >> mountpoint)) { errno = EIO; return Error("parse mountinfo"); }
+    if ((!path.empty() && mountpoint == path) || (device && number == std::to_string(major(device)) + ":" + std::to_string(minor(device)))) *found = true;
+  }
+  if (input.bad()) { errno = EIO; return Error("read mountinfo"); } return true;
+}
+bool Block(const std::string& path, dev_t* device, std::string* filesystem) {
+  Fd fd(open(path.c_str(), O_RDONLY | O_CLOEXEC)); struct stat info {};
+  if (fd.n < 0 || fstat(fd.n, &info) != 0 || !S_ISBLK(info.st_mode)) { errno = EINVAL; return Error("block identity " + path); }
+  std::array<unsigned char, 4> magic{}; std::array<unsigned char, 2> ext4{};
+  if (pread(fd.n, ext4.data(), ext4.size(), 0x438) != 2 || pread(fd.n, magic.data(), magic.size(), 0x400) != 4) return Error("read filesystem magic");
+  if (ext4[0] == 0x53 && ext4[1] == 0xef) *filesystem = "ext4";
+  else if (magic == std::array<unsigned char, 4>{0xe2, 0xe1, 0xf5, 0xe0}) *filesystem = "erofs";
+  else { errno = EINVAL; return Error("unsupported filesystem"); }
+  *device = info.st_rdev; return true;
+}
+bool SetReadOnly(const std::string& path, bool readonly) {
+  Fd fd(open(path.c_str(), O_RDONLY | O_CLOEXEC)); int value = readonly ? 1 : 0;
+  return (fd.n >= 0 && ioctl(fd.n, BLKROSET, &value) == 0) || Error("restore/set block mode " + path);
+}
+int Wait(pid_t child) {
+  int status = 0; pid_t waited;
+  do { waited = waitpid(child, &status, 0); } while (waited < 0 && errno == EINTR);
+  if (waited != child) { Error("wait child"); return 128; }
+  if (WIFEXITED(status)) return WEXITSTATUS(status);
+  return WIFSIGNALED(status) ? 128 + WTERMSIG(status) : 129;
+}
+bool Write(int fd, const void* data, size_t bytes) {
+  const auto* cursor = static_cast<const char*>(data);
+  while (bytes) {
+    auto n = write(fd, cursor, bytes); if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) return Error("write protected broker state");
+    cursor += n; bytes -= n;
+  }
+  return true;
+}
+class Real final : public backuptool_broker::Operations {
+ public:
+  explicit Real(std::vector<Part> parts) : parts_(std::move(parts)) {}
+  bool Validate() override {
+    char* context = nullptr; if (getcon(&context) != 0) return Error("getcon");
+    const bool domain = context && std::string(context) == "u:r:update_engine:s0"; freecon(context);
+    if (!domain) { errno = EPERM; return Error("caller domain"); }
+    std::set<dev_t> targets, sources; std::set<std::string> names;
+    for (auto& p : parts_) {
+      std::string source_fs;
+      if (!names.insert(p.name).second || !Block(p.target, &p.target_id, &p.filesystem) || !Block(p.source, &p.source_id, &source_fs)) return false;
+      if (!targets.insert(p.target_id).second || !sources.insert(p.source_id).second || (p.name == "system" && (p.filesystem != "ext4" || source_fs != "ext4"))) { errno = EINVAL; return Error("duplicate device or primary filesystem"); }
+      bool mounted = false;
+      if (!Mounted("", &mounted, p.target_id) || mounted) { errno = EBUSY; return Error("target is already mounted"); }
+    }
+    for (auto target : targets) if (sources.count(target)) { errno = EINVAL; return Error("inactive device aliases active source"); }
+    bool mounted = false;
+    if (!Directory(kRoot) || !Mounted(kRoot, &mounted)) return false;
+    if (mounted) { errno = EBUSY; return Error("workspace is already mounted"); } return true;
+  }
+  bool IsolateMounts() override {
+    if (unshare(CLONE_NEWNS) != 0) return Error("private mount namespace");
+    return mount(nullptr, "/", nullptr, MS_REC | MS_PRIVATE, nullptr) == 0 || Error("disable mount propagation");
+  }
+  bool MountWorkspace() override {
+    return mount("tmpfs", kRoot, "tmpfs", MS_NOSUID | MS_NODEV,
+        "size=1g,mode=0700,rootcontext=u:object_r:backuptool_broker_root_file:s0") == 0 || Error("mount bounded workspace");
+  }
+  bool MakeDirectory(const std::string& path) override {
+    const char* label = path == "/postinstall/tmp" ? kWorkContext : kRootContext;
+    if (setfscreatecon(label) != 0) return Error("set directory label");
+    bool made = mkdir(path.c_str(), 0700) == 0; int saved = errno;
+    if (setfscreatecon(nullptr) != 0) return Error("reset create label");
+    errno = saved;
+    return made || Error("mkdir " + path);
+  }
+  bool MountTarget(const std::string& path) override {
+    return Mount(parts_.front(), path);
+  }
+  bool BindSystem(const std::string& root, const std::string& view) override { return Bind(root, view, "system"); }
+  bool MountExtras() override {
+    for (size_t i = 1; i < parts_.size(); ++i) {
+      const auto raw = "/postinstall/inactive-" + parts_[i].name;
+      if (!Mount(parts_[i], raw) || !Bind(raw, "/postinstall/" + parts_[i].name, parts_[i].name)) return false;
+    }
+    return true;
+  }
+  bool SnapshotContexts() override {
+    std::string manifest, devices;
+    for (const auto& p : parts_) {
+      manifest += p.name + " " + p.filesystem + "\n";
+      devices += p.name + " " + std::to_string(major(p.target_id)) + ":" + std::to_string(minor(p.target_id)) + " " + std::to_string(major(p.source_id)) + ":" + std::to_string(minor(p.source_id)) + "\n";
+    }
+    if (!State("/postinstall/partitions", manifest) || !State("/postinstall/.broker/devices", devices)) return false;
+    for (const auto& p : parts_) {
+      const auto name = p.name == "system" ? "plat_file_contexts" : p.name + "_file_contexts";
+      const auto base = "/postinstall/" + p.name + "/etc/selinux/";
+      if (!Directory("/postinstall/" + p.name + "/etc") || !Directory(base.substr(0, base.size() - 1))) {
+        errno = ENOENT; return Error("target context directory " + p.name);
+      }
+      Fd input(open((base + name).c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+      if (input.n < 0) {
+        if (errno == ENOENT && p.name != "system") continue;
+        return Error("target context file " + name);
+      }
+      struct stat info {}; if (fstat(input.n, &info) != 0 || !S_ISREG(info.st_mode) || info.st_size <= 0 || info.st_size > 2 * 1024 * 1024) { errno = EINVAL; return Error("context input size/type"); }
+      std::string bytes(info.st_size, '\0'); size_t offset = 0;
+      while (offset < bytes.size()) {
+        auto n = read(input.n, bytes.data() + offset, bytes.size() - offset); if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return Error("read target context");
+        offset += n;
+      }
+      if (!State("/postinstall/.broker/contexts/" + name, bytes)) return false;
+    }
+    return true;
+  }
+  int RunWorker() override { return backuptool_broker::RunStagedWorker(); }
+  bool UnmountIfMounted(const std::string& path) override {
+    bool mounted = false; if (!Mounted(path, &mounted)) return false;
+    if (!mounted) return true;
+    return umount(path.c_str()) == 0 || Error("strict unmount " + path);
+  }
+  int Commit() override {
+    // Validate every target first. A V3 attempt to mutate EROFS, a bad
+    // symlink, missing label or insufficient capacity aborts before any write.
+    for (const auto& p : parts_) if (Store(p, "--check") != 0) return 40;
+    for (const auto& p : parts_) {
+      if (p.filesystem != "ext4") continue;
+      if (!SetReadOnly(p.target, false)) return 41;
+      int status = Store(p, "--apply");
+      const bool readonly = SetReadOnly(p.target, true);
+      if (status) return status;
+      if (!readonly) return 42;
+    }
+    return 0;
+  }
+ private:
+  bool Mount(const Part& p, const std::string& destination) {
+    return mount(p.target.c_str(), destination.c_str(), p.filesystem.c_str(),
+        MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOATIME, kTargetOptions) == 0 || Error("read-only inactive " + p.name);
+  }
+  bool Bind(const std::string& raw, const std::string& view, const std::string& name) {
+    const auto nested = raw + "/" + name; struct stat info {}; std::string source = raw;
+    if (lstat(nested.c_str(), &info) == 0) {
+      if (!S_ISDIR(info.st_mode)) { errno = EINVAL; return Error("inactive root layout/symlink"); }
+      source = nested;
+    } else if (errno != ENOENT) return Error("inactive root stat");
+    return mount(source.c_str(), view.c_str(), nullptr, MS_BIND, nullptr) == 0 || Error("bind inactive " + name);
+  }
+  bool State(const std::string& path, const std::string& data) {
+    if (setfscreatecon(kRootContext) != 0) return Error("broker file context");
+    Fd fd(open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0400));
+    const int saved = errno; const bool reset = setfscreatecon(nullptr) == 0; errno = saved;
+    if (!reset || fd.n < 0) return Error("create protected broker state");
+    return (Write(fd.n, data.data(), data.size()) && fsync(fd.n) == 0) || Error("flush broker state");
+  }
+  int Store(const Part& p, const char* action) {
+    const pid_t broker = getpid();
+    const pid_t child = fork(); if (child < 0) { Error("fork offline committer"); return 43; }
+    if (!child) {
+      if (prctl(PR_SET_PDEATHSIG, SIGKILL) != 0 || getppid() != broker) _exit(126);
+      execl("/system/bin/backuptool_store", "backuptool_store", action,
+            p.name.c_str(), p.target.c_str(), p.source.c_str(), static_cast<char*>(nullptr));
+      Error("exec offline committer"); _exit(127);
+    }
+    return Wait(child);
+  }
+  std::vector<Part> parts_;
+};
+}  // namespace
+int main(int argc, char** argv) {
+  if (argc < 4 || std::string(argv[1]) != "--v2" || (argc - 4) % 3) {
+    std::cerr << "Usage: backuptool_broker --v2 <system-target> <system-source> [name target source]...\n"; return 2;
+  }
+  std::vector<Part> parts = {{"system", argv[2], argv[3], ""}};
+  for (int i = 4; i < argc; i += 3) {
+    const std::string name = argv[i];
+    if (name != "vendor" && name != "product" && name != "system_ext" && name != "odm") return 2;
+    parts.push_back({name, argv[i + 1], argv[i + 2], ""});
+  }
+  if (parts.size() > 5) return 2;
+  const pid_t caller = getppid();
+  if (caller <= 1 || prctl(PR_SET_PDEATHSIG, SIGKILL) != 0 || getppid() != caller) return 2;
+  Real operations(std::move(parts)); return backuptool_broker::Run(operations);
+}
diff --git a/backuptool_broker/worker.cpp b/backuptool_broker/worker.cpp
new file mode 100644
index 0000000..02e1413
--- /dev/null
+++ b/backuptool_broker/worker.cpp
@@ -0,0 +1,166 @@
+// Copyright (C) 2026 CyberWei
+// SPDX-License-Identifier: Apache-2.0
+#include "worker.h"
+#include <linux/audit.h>
+#include <linux/sched.h>
+#include <linux/seccomp.h>
+#include <selinux/selinux.h>
+#include <sys/prctl.h>
+#include <sys/wait.h>
+#include <signal.h>
+#include <unistd.h>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <iostream>
+#include <time.h>
+namespace backuptool_broker {
+namespace {
+constexpr uint32_t kNamespaces = CLONE_NEWNS | CLONE_NEWCGROUP | CLONE_NEWUTS |
+    CLONE_NEWIPC | CLONE_NEWUSER | CLONE_NEWPID | CLONE_NEWNET;
+void Architecture(std::vector<sock_filter>& code, uint32_t arch, uint32_t pgid,
+                  uint32_t sid, uint32_t clone, uint32_t unshare,
+                  uint32_t setns, uint32_t mask = UINT32_MAX) {
+  std::vector<sock_filter> body;
+  body.push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(seccomp_data, nr)));
+  if (mask != UINT32_MAX) body.push_back(BPF_STMT(BPF_ALU | BPF_AND | BPF_K, mask));
+  for (auto number : {pgid, sid, unshare, setns}) {
+    body.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, number, 0, 1));
+    body.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | EPERM));
+  }
+  // clone3's pointed-to flags cannot be safely inspected by classic BPF.
+  // ENOSYS permits libc to fall back to traditional clone/fork.
+  body.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 435, 0, 1));
+  body.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | ENOSYS));
+  body.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, clone, 0, 4));
+  body.push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(seccomp_data, args[0])));
+  body.push_back(BPF_STMT(BPF_ALU | BPF_AND | BPF_K, kNamespaces));
+  body.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 0, 1, 0));
+  body.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | EPERM));
+  body.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW));
+  code.push_back(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, arch, 0, static_cast<uint8_t>(body.size())));
+  code.insert(code.end(), body.begin(), body.end());
+}
+#ifndef __ANDROID__
+const WorkerFixture* fixture = nullptr;
+#endif
+bool Filter() {
+#ifndef __ANDROID__
+  if (fixture && fixture->fail_filter) { errno = EPERM; return false; }
+  // Rootless host fixtures cannot use Android updater CAP_SYS_ADMIN. This
+  // host-only no_new_privs setup is NOT compiled into the device executable;
+  // device domain transition must retain the normal SELinux exec semantics.
+  if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0) return false;
+#endif
+  auto bytes = WorkerFilter();
+  sock_fprog program{static_cast<unsigned short>(bytes.size()), bytes.data()};
+  return prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &program) == 0;
+}
+bool Context() {
+#ifndef __ANDROID__
+  if (fixture) { if (fixture->fail_context) errno = EPERM; return !fixture->fail_context; }
+#endif
+  return setexeccon("u:r:backuptool:s0") == 0;
+}
+const char* Script() {
+#ifndef __ANDROID__
+  if (fixture) return fixture->script;
+#endif
+  return "/system/bin/backuptool_staged.sh";
+}
+const char* Workspace() {
+#ifndef __ANDROID__
+  if (fixture) return fixture->workspace;
+#endif
+  return "/postinstall/tmp";
+}
+const char* Path() {
+#ifndef __ANDROID__
+  if (fixture) return fixture->path;
+#endif
+  return "/system/bin";
+}
+void ParentDied(int) {
+  // Installed only AFTER this controller creates its own process group.
+  // Its live PID reserves this group ID, so no unrelated group is targeted.
+  kill(-getpid(), SIGKILL);
+  _exit(129);
+}
+int Status(int value) {
+  if (WIFEXITED(value)) return WEXITSTATUS(value);
+  return WIFSIGNALED(value) ? 128 + WTERMSIG(value) : 129;
+}
+}  // namespace
+std::vector<sock_filter> WorkerFilter() {
+  std::vector<sock_filter> bytes;
+  bytes.push_back(BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(seccomp_data, arch)));
+  // Numbers follow Android arm64/ARM UAPI syscall tables. The ARM mask also
+  // blocks historical OABI-number spellings rather than permitting an alias.
+  Architecture(bytes, AUDIT_ARCH_AARCH64, 154, 157, 220, 97, 268);
+  Architecture(bytes, AUDIT_ARCH_ARM, 57, 66, 120, 337, 375, 0x000fffff);
+#ifndef __ANDROID__
+  Architecture(bytes, AUDIT_ARCH_X86_64, 109, 112, 56, 272, 308, 0xbfffffff);
+  Architecture(bytes, AUDIT_ARCH_I386, 57, 66, 120, 310, 346);
+#endif
+  bytes.push_back(BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS));
+  return bytes;
+}
+int RunStagedWorker() {
+  // Only descendants of this short-lived broker are adopted. No global init,
+  // cgroup configuration, or unrelated process is changed.
+  if (prctl(PR_SET_CHILD_SUBREAPER, 1) != 0) return 26;
+  struct sigaction child_action {}; child_action.sa_handler = SIG_DFL;
+  sigemptyset(&child_action.sa_mask);
+  if (sigaction(SIGCHLD, &child_action, nullptr) != 0) return 26;
+  const pid_t broker = getpid(); const pid_t controller = fork();
+  if (controller < 0) return 26;
+  if (!controller) {
+    if (setpgid(0, 0) != 0) _exit(27);
+    struct sigaction action {}; action.sa_handler = ParentDied;
+    sigemptyset(&action.sa_mask);
+    sigset_t unblock; sigemptyset(&unblock); sigaddset(&unblock, SIGTERM);
+    if (sigaction(SIGTERM, &action, nullptr) != 0 ||
+        sigprocmask(SIG_UNBLOCK, &unblock, nullptr) != 0 ||
+        prctl(PR_SET_PDEATHSIG, SIGTERM) != 0) _exit(27);
+    if (getppid() != broker) ParentDied(SIGTERM);
+    const pid_t worker = fork(); if (worker < 0) _exit(28);
+    if (!worker) {
+      signal(SIGTERM, SIG_DFL);
+      if (!Filter()) _exit(125);
+      if (setenv("BACKUPTOOL_BROKER_PROTOCOL", "2", 1) != 0 ||
+          setenv("BACKUPTOOL_BROKER_WORKSPACE", "1", 1) != 0 ||
+          setenv("PATH", Path(), 1) != 0 || chdir(Workspace()) != 0) _exit(29);
+      unsetenv("BACKUPTOOL_LEGACY_WORKSPACE");
+      if (!Context()) _exit(126);
+      execl(Script(), "backuptool_staged.sh", static_cast<char*>(nullptr));
+      _exit(127);
+    }
+    int status = 0; pid_t waited;
+    do { waited = waitpid(worker, &status, 0); } while (waited < 0 && errno == EINTR);
+    _exit(waited == worker ? Status(status) : 128);
+  }
+  // WNOWAIT keeps the private group leader's zombie/PID reserved until killpg.
+  // Never reap first and then signal a numeric group ID that could be reused.
+  siginfo_t event {}; int waited;
+  do { waited = waitid(P_PID, controller, &event, WEXITED | WNOWAIT); } while (waited < 0 && errno == EINTR);
+  if (waited != 0) return 128;
+  if (kill(-controller, SIGKILL) != 0 && errno != ESRCH) return 130;
+  int status = 0; pid_t pid;
+  do { pid = waitpid(controller, &status, 0); } while (pid < 0 && errno == EINTR);
+  int result = pid == controller ? Status(status) : 128;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  for (;;) {
+    int ignored = 0; pid = waitpid(-controller, &ignored, WNOHANG);
+    if (pid > 0 || (pid < 0 && errno == EINTR)) continue;
+    if (pid < 0 && errno == ECHILD) return result;
+    if (pid < 0 || std::chrono::steady_clock::now() >= deadline) return result ? result : 131;
+    timespec pause{0, 10000000}; nanosleep(&pause, nullptr);
+  }
+}
+#ifndef __ANDROID__
+int RunStagedWorkerForTest(const WorkerFixture& options) {
+  fixture = &options; int result = RunStagedWorker(); fixture = nullptr; return result;
+}
+#endif
+}  // namespace backuptool_broker
