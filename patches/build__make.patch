+def RecoveryNeedsTwoStepImage(info_dict, unpack_dir, has_recovery):
+  """Keep source recovery two-step behavior; validate pinned A/B-only prebuilts."""
+  if info_dict.get("prebuilt_recovery_image") != "true":
+    return True
+  if (not has_recovery or info_dict.get("ab_update") != "true" or
+      info_dict.get("allow_non_ab") == "true"):
+    raise ExternalError("Pinned prebuilt recovery requires dedicated pure A/B recovery")
+  expected = info_dict.get("prebuilt_recovery_image_sha256", "")
+  if len(expected) != 64 or any(c not in "0123456789abcdef" for c in expected):
+    raise ExternalError("Pinned prebuilt recovery requires an exact SHA-256")
+  try:
+    size = int(info_dict.get("recovery_size", 0))
+  except (TypeError, ValueError):
+    raise ExternalError("Pinned prebuilt recovery has invalid partition size")
+  if size <= 0:
+    raise ExternalError("Pinned prebuilt recovery requires a partition size")
+  prebuilt = os.path.join(unpack_dir, "BOOTABLE_IMAGES", "recovery.img")
+  for path in (prebuilt, os.path.join(unpack_dir, "IMAGES", "recovery.img")):
+    if path != prebuilt and not os.path.lexists(path):
+      continue
+    if not os.path.isfile(path) or os.path.islink(path):
+      raise ExternalError("Pinned prebuilt recovery is missing or unsafe: " + path)
+    if os.path.getsize(path) > size:
+      raise ExternalError("Pinned prebuilt recovery exceeds its partition size")
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+      for block in iter(lambda: stream.read(1024 * 1024), b""):
+        digest.update(block)
+    if digest.hexdigest() != expected:
+      raise ExternalError("Pinned prebuilt recovery SHA-256 mismatch: " + path)
+  # Pure A/B payload writes recovery to its own partition. The special image
+  # booted from /boot by non_ab_ota is neither used nor constructible here.
+  # Do not fabricate it or rebuild a different source ramdisk.
+  return False
+
