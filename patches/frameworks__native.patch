+TEST_F(SchedulerTest, reapplyDisplayModesRequestsCachedChoice) {
+    mScheduler->registerDisplay(kDisplayId1, ui::DisplayConnectionType::Internal,
+                                std::make_shared<RefreshRateSelector>(kDisplay1Modes,
+                                                                      kDisplay1Mode60->getId()));
+    auto layer = kLayer;
+    layer.vote = RefreshRateSelector::LayerVoteType::Max;
+    mScheduler->setContentRequirements({layer});
+    // getPreferredDisplayMode caches 120Hz without submitting a mode request.
+    ASSERT_EQ(mScheduler->getPreferredDisplayMode(), kDisplay1Mode120_120);
+
+    EXPECT_CALL(mSchedulerCallback,
+                requestDisplayModes(UnorderedElementsAre(
+                        Field(&DisplayModeRequest::mode, kDisplay1Mode120_120))))
+            .Times(1);
+    FTL_FAKE_GUARD(kMainThreadContext, mScheduler->reapplyDisplayModes());
+}
+
+TEST_F(SchedulerTest, reapplyDisplayModesRecomputesAfterIdle) {
+    mScheduler->registerDisplay(kDisplayId1, ui::DisplayConnectionType::Internal,
+                                std::make_shared<RefreshRateSelector>(kDisplay1Modes,
+                                                                      kDisplay1Mode60->getId()));
+    auto layer = kLayer;
+    layer.vote = RefreshRateSelector::LayerVoteType::Max;
+    mScheduler->setContentRequirements({layer});
+    ASSERT_EQ(mScheduler->getPreferredDisplayMode(), kDisplay1Mode120_120);
+    // An old 120Hz choice must not be replayed if the display has since become idle.
+    mScheduler->setTouchStateAndIdleTimerPolicy(kDisplayId1, {.idle = true});
+    EXPECT_CALL(mSchedulerCallback,
+                requestDisplayModes(UnorderedElementsAre(
+                        Field(&DisplayModeRequest::mode, kDisplay1Mode60_60))))
+            .Times(1);
+    FTL_FAKE_GUARD(kMainThreadContext, mScheduler->reapplyDisplayModes());
+    // Reconciliation must also update the cache so the next activity transition can raise it.
+    mScheduler->setTouchStateAndIdleTimerPolicy(kDisplayId1, {.idle = false});
+    EXPECT_CALL(mSchedulerCallback,
+                requestDisplayModes(UnorderedElementsAre(
+                        Field(&DisplayModeRequest::mode, kDisplay1Mode120_120))))
+            .Times(1);
+    mScheduler->touchTimerCallback(TestableScheduler::TimerState::Reset);
+}
+
+TEST_F(SchedulerTest, reapplyDisplayModesHonorsSingleModeDisplay) {
+    EXPECT_CALL(mSchedulerCallback,
+                requestDisplayModes(UnorderedElementsAre(
+                        Field(&DisplayModeRequest::mode, kDisplay1Mode60_60))))
+            .Times(1);
+    FTL_FAKE_GUARD(kMainThreadContext, mScheduler->reapplyDisplayModes());
+}
+
+TEST_F(SchedulerTest, reapplyDisplayModesIncludesPoweredOnFollowers) {
+    SET_FLAG_FOR_TEST(flags::follower_arbitrary_refresh_rate_selection, true);
