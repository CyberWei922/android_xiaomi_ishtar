+    mScheduler->registerDisplay(kDisplayId1, ui::DisplayConnectionType::Internal,
+                                std::make_shared<RefreshRateSelector>(kDisplay1Modes,
+                                                                      kDisplay1Mode60->getId()));
+    mScheduler->registerDisplay(kDisplayId2, ui::DisplayConnectionType::External,
+                                std::make_shared<RefreshRateSelector>(kDisplay2Modes,
+                                                                      kDisplay2Mode60->getId()));
+    // The external display would otherwise win a same-rate pacesetter tie.
+    FTL_FAKE_GUARD(kMainThreadContext, mScheduler->forcePacesetterDisplay(kDisplayId1));
+    FTL_FAKE_GUARD(kMainThreadContext,
+                   mScheduler->setDisplayPowerMode(kDisplayId1, hal::PowerMode::ON));
+    FTL_FAKE_GUARD(kMainThreadContext,
