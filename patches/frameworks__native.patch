+    // The external display would otherwise win a same-rate pacesetter tie.
+    FTL_FAKE_GUARD(kMainThreadContext, mScheduler->forcePacesetterDisplay(kDisplayId1));
+    FTL_FAKE_GUARD(kMainThreadContext,
+                   mScheduler->setDisplayPowerMode(kDisplayId1, hal::PowerMode::ON));
+    FTL_FAKE_GUARD(kMainThreadContext,
+                   mScheduler->setDisplayPowerMode(kDisplayId2, hal::PowerMode::OFF));
+
+    // Empty content selects the highest rate; request it explicitly for this test.
+    auto layer = kLayer;
+    layer.vote = RefreshRateSelector::LayerVoteType::Max;
+    mScheduler->setContentRequirements({layer});
+    ASSERT_EQ(mScheduler->getPacesetterDisplayId(), kDisplayId1);
