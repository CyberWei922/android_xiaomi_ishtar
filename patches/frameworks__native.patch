+            });
+    EXPECT_CALL(*mEventThread,
+                onModeAndFrameRateOverridesChanged(_, kDisplay1Mode120_120, _, _, _))
+            .Times(1);
+    FTL_FAKE_GUARD(kMainThreadContext, mScheduler->reapplyDisplayModes());
+}
