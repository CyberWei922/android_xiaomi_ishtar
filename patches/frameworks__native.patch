+void Scheduler::reapplyDisplayModes() {
+    SFTRACE_CALL();
+    DisplayModeChoiceMap modeChoices;
+    std::vector<display::DisplayModeRequest> modeRequests;
+    GlobalSignals consideredSignals;
+    Fps pacesetterFps;
+    {
+        std::scoped_lock policyLock(mPolicyLock);
+        std::scoped_lock displayLock(mDisplayLock);
+        if (!mPacesetterDisplayId) return;
+
+        modeChoices = chooseDisplayModes();
+        modeRequests.reserve(modeChoices.size());
+        for (const auto& [id, choice] : modeChoices) {
+            mPolicy.modeOpt[id] = choice.mode;
+            if (id == *mPacesetterDisplayId) {
+                consideredSignals = choice.consideredSignals;
+                pacesetterFps = choice.mode.fps;
+            }
+            modeRequests.emplace_back(
+                    display::DisplayModeRequest{.mode = choice.mode, .seamless = true});
+        }
+    }
+
+    // Always resubmit, even if the cache already contains these choices. As in applyPolicy,
+    // release Scheduler locks before calling SurfaceFlinger and emit events separately.
+    mSchedulerCallback.requestDisplayModes(std::move(modeRequests));
+    const bool frameRateOverridesChanged = updateFrameRateOverrides(consideredSignals, pacesetterFps);
+    for (const auto& [id, choice] : modeChoices) {
+        if (choice.consideredSignals.shouldEmitEvent() || frameRateOverridesChanged) {
+            onDisplayModeAndFrameRateOverridesChanged(id, choice.mode,
+                                                      /*clearContentRequirements*/ true);
+        }
+    }
+}
