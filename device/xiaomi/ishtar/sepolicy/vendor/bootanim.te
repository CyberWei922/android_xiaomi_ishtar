# The shipped startup path calls the registered Qualcomm QSPM HAL.
# Use its existing HIDL client contract, including callbacks and fd passing.
# No compositor, frame-rate, performance hint or HAL implementation is changed.
hal_client_domain(bootanim, vendor_hal_qspmhal)
