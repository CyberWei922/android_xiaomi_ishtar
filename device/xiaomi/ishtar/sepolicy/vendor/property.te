# Status outputs of the Xiaomi Mtd service; no generic vendor property writes.
vendor_restricted_prop(vendor_mtd_widevine_prop)
vendor_restricted_prop(vendor_mtd_rpmb_prop)

# Additional libmt status outputs observed on 1792246397.
vendor_restricted_prop(vendor_mtd_provision_status_prop)
vendor_restricted_prop(vendor_mtd_feature_state_prop)

# libmt@1.3 reports RKP provisioning status; keep ownership vendor-side.
vendor_restricted_prop(vendor_mtd_rkp_status_prop)

# Shipped libmt@1.3 reports device-attestation reload status.
vendor_restricted_prop(vendor_mtd_attestation_status_prop)
