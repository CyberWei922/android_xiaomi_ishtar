# Camera time-of-flight range sensor
/dev/stmvl53l5 u:object_r:vendor_stmvl53l5_device:s0

# Vendor external/virtual HIDL camera provider
/vendor/bin/hw/android\.hardware\.camera\.provider@2\.7-virtual-camera-service u:object_r:hal_camera_default_exec:s0

# Xiaomi HIDL vendor daemons: each leaves init through its own exec type.
/odm/bin/fidoca u:object_r:vendor_mfidoca_exec:s0
/odm/bin/mtd@1\.3 u:object_r:vendor_mtd_exec:s0
/odm/bin/tidad@1\.2 u:object_r:vendor_tida_exec:s0

# QRTR lookup uses the existing Qualcomm QRTR domain and socket policy.
/vendor/bin/qrtr-lookup u:object_r:vendor_qrtr_exec:s0

# QRTR lookup output (also relabeled for data-preserving upgrades).
/data/vendor/qrtr(/.*)? u:object_r:vendor_qrtr_lookup_data_file:s0

# Public camera algorithms already exported by vendor/etc/public.libraries.txt.
# The HTP stub is a runtime helper of that in-process SNPE implementation.
# Exact 64-bit files only; linker namespace/public-library lists stay unchanged.
/odm/lib64/libmialgo_ai_vision\.so u:object_r:vendor_public_lib_file:s0
/vendor/lib64/libSNPE\.so u:object_r:vendor_public_lib_file:s0
/vendor/lib64/libSnpeHtpV73Stub\.so u:object_r:vendor_public_lib_file:s0

# C++ runtime required by the existing public mialgo/SNPE libraries.
# This is a transitive dependency, not a new public.libraries entry.
/vendor/lib64/libc\+\+_shared\.so u:object_r:vendor_public_lib_file:s0

# Xiaomi RIL synchronization output uses the existing radio data contract.
/data/vendor/diag(/.*)? u:object_r:vendor_radio_vendor_data_file:s0
# Dedicated diag-router boot FIFO directory; do not label all modem data.
/data/vendor/modem/diag_logs(/.*)? u:object_r:vendor_ishtar_diag_router_data_file:s0
