# Interfaces observed in the shipped daemon imports and init-domain AVCs.
# HIDL context keys omit interface versions, covering their inherited versions.

hal_attribute(xiaomi_mfidoca)
type vendor_mfidoca_hwservice, hwservice_manager_type, protected_hwservice;
hal_attribute_hwservice(hal_xiaomi_mfidoca, vendor_mfidoca_hwservice)
binder_call(hal_xiaomi_mfidoca_client, hal_xiaomi_mfidoca_server)

hal_attribute(xiaomi_mtd)
type vendor_mtd_hwservice, hwservice_manager_type, protected_hwservice;
hal_attribute_hwservice(hal_xiaomi_mtd, vendor_mtd_hwservice)
binder_call(hal_xiaomi_mtd_client, hal_xiaomi_mtd_server)

hal_attribute(xiaomi_tida)
type vendor_tida_hwservice, hwservice_manager_type, protected_hwservice;
hal_attribute_hwservice(hal_xiaomi_tida, vendor_tida_hwservice)
binder_call(hal_xiaomi_tida_client, hal_xiaomi_tida_server)
